---
import AnalyticsHead from "../components/AnalyticsHead.astro";
import CaseBehavior from "../components/scripts/CaseBehavior.astro";
import "../styles/case.css";

interface Props { lang: string; ogLocale?: string; title: string; description: string; canonical: string; ogImage: string; ogImageAlt?: string; analytics?: boolean; bodyClass?: string; alternates?: Record<"pt" | "en" | "es" | "x-default", string>; }
const { lang, ogLocale, title, description, canonical, ogImage, ogImageAlt, analytics = true, bodyClass, alternates } = Astro.props;
const defaultAlternates = { pt: "https://renanmarcal.com/cases/case-priorizacao-visitas-comerciais-mercado-pago.html", en: "https://renanmarcal.com/en/cases/case-priorizacao-visitas-comerciais-mercado-pago.html", es: "https://renanmarcal.com/es/cases/case-priorizacao-visitas-comerciais-mercado-pago.html", "x-default": "https://renanmarcal.com/cases/case-priorizacao-visitas-comerciais-mercado-pago.html" };
const resolvedAlternates = analytics ? (alternates ?? defaultAlternates) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    <meta property="og:site_name" content="Renan Marçal" />
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    {resolvedAlternates && <>{Object.entries(resolvedAlternates).map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}</>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {analytics && <AnalyticsHead />}
  </head>
  <body class={bodyClass}><slot /><CaseBehavior /></body>
</html>

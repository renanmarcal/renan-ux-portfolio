---
import CaseTopbar from "./CaseTopbar.astro";
import SiteFooter from "./SiteFooter.astro";
import CaseLayout from "../layouts/CaseLayout.astro";
import type { PrioritizationCaseData } from "../data/cases";

interface Props { data: PrioritizationCaseData; source: string; }
const { data, source } = Astro.props;
const editorial = source.match(/<main id="main-content">[\s\S]*?<\/main>\s*<a class="next-case"[\s\S]*?<\/a>/)?.[0];
if (!editorial) throw new Error("Não foi possível extrair o conteúdo editorial do case de priorização.");
---
<CaseLayout {...data}>
  <a class="skip-link" href="#main-content">{data.skipLink}</a>
  <CaseTopbar crumb={data.crumb} locale={data.locale} />
  <Fragment set:html={editorial} />
  <SiteFooter locale={data.locale} {...data.footer} />
</CaseLayout>

---
import AnalyticsHead from "../components/AnalyticsHead.astro";
import NotFoundBehavior from "../components/scripts/NotFoundBehavior.astro";
import "../styles/case.css";
import "../styles/not-found.css";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />
    <title>Página não encontrada · Renan Marçal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <AnalyticsHead />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <header class="topbar"><div class="wrap"><a href="/" data-gtag-event="logo_home_click" data-gtag-location="404">← Renan Marçal</a><span class="crumb">Página não encontrada</span></div></header>
    <main class="not-found-main" id="main-content"><p class="kicker">404</p><h1>Página não<br />encontrada</h1><p class="lead">O endereço que você acessou não existe ou foi movido.</p><a class="back-link" href="/" data-gtag-event="404_return_click">← voltar pro portfólio</a></main>
    <NotFoundBehavior />
  </body>
</html>
